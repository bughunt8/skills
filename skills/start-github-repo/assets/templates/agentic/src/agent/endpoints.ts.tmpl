export type AgentRoutePath =
  | "/api/agent/sessions"
  | "/api/agent/sessions/:sessionId/turns"
  | "/api/agent/sessions/:sessionId/pending-approval"
  | "/api/agent/sessions/:sessionId/approvals/:hitlId"
  | "/api/agent/sessions/:sessionId/mfa/:hitlId"
  | "/api/agent/sessions/:sessionId/notify/:hitlId";

export interface AgentRouteDefinition {
  method: "POST" | "GET";
  path: AgentRoutePath;
  purpose: string;
  request: Record<string, unknown>;
  response: Record<string, unknown>;
  guards: string[];
}

