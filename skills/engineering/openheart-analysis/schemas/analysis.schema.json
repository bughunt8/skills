{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bughunt8:openheart-analysis:1.0",
  "title": "OpenHeart-derived normalized analysis, not binary SCPG",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "repository",
        "revision",
        "scope",
        "languages",
        "exclusions"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "line_count": {
            "type": "integer",
            "minimum": 0
          },
          "encoding": {
            "const": "utf-8"
          },
          "role": {
            "enum": [
              "source",
              "trace",
              "snapshot",
              "specification"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "line_count",
          "encoding",
          "role"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "stages": {
      "type": "object",
      "properties": {
        "ingestion": {
          "$ref": "#/$defs/graph"
        },
        "syntax": {
          "$ref": "#/$defs/graph"
        },
        "symbols": {
          "$ref": "#/$defs/graph"
        },
        "control_flow": {
          "$ref": "#/$defs/graph"
        },
        "data_flow": {
          "$ref": "#/$defs/graph"
        },
        "calls": {
          "$ref": "#/$defs/graph"
        },
        "traceability": {
          "$ref": "#/$defs/graph"
        },
        "paths": {
          "$ref": "#/$defs/graph"
        },
        "uml": {
          "$ref": "#/$defs/graph"
        },
        "unified": {
          "$ref": "#/$defs/graph"
        }
      },
      "required": [
        "ingestion",
        "syntax",
        "symbols",
        "control_flow",
        "data_flow",
        "calls",
        "traceability",
        "paths",
        "uml",
        "unified"
      ],
      "additionalProperties": false
    },
    "diagrams": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/graph"
        },
        "package": {
          "$ref": "#/$defs/graph"
        },
        "component": {
          "$ref": "#/$defs/graph"
        },
        "composite": {
          "$ref": "#/$defs/graph"
        },
        "object": {
          "$ref": "#/$defs/graph"
        },
        "deployment": {
          "$ref": "#/$defs/graph"
        },
        "profile": {
          "$ref": "#/$defs/graph"
        },
        "sequence": {
          "$ref": "#/$defs/graph"
        },
        "statemachine": {
          "$ref": "#/$defs/graph"
        },
        "activity": {
          "$ref": "#/$defs/graph"
        },
        "usecase": {
          "$ref": "#/$defs/graph"
        },
        "communication": {
          "$ref": "#/$defs/graph"
        },
        "interaction": {
          "$ref": "#/$defs/graph"
        },
        "timing": {
          "$ref": "#/$defs/graph"
        },
        "cfg": {
          "$ref": "#/$defs/graph"
        },
        "dfg": {
          "$ref": "#/$defs/graph"
        },
        "cdg": {
          "$ref": "#/$defs/graph"
        },
        "callgraph": {
          "$ref": "#/$defs/graph"
        },
        "robdd": {
          "$ref": "#/$defs/graph"
        },
        "ast": {
          "$ref": "#/$defs/graph"
        }
      },
      "required": [
        "class",
        "package",
        "component",
        "composite",
        "object",
        "deployment",
        "profile",
        "sequence",
        "statemachine",
        "activity",
        "usecase",
        "communication",
        "interaction",
        "timing",
        "cfg",
        "dfg",
        "cdg",
        "callgraph",
        "robdd",
        "ast"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "source",
    "files",
    "stages",
    "diagrams",
    "limitations"
  ],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "file",
        "line_start",
        "line_end",
        "excerpt"
      ],
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "properties": {
        "visibility": {
          "enum": [
            "+",
            "-",
            "#",
            "~"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type_name": {
          "type": "string",
          "minLength": 0
        },
        "signature": {
          "type": "string",
          "minLength": 0
        },
        "is_static": {
          "type": "boolean"
        },
        "is_final": {
          "type": "boolean"
        }
      },
      "required": [
        "visibility",
        "name",
        "type_name",
        "signature",
        "is_static",
        "is_final"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "enum": [
            "source",
            "derived",
            "inferred",
            "observed"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "attributes": {
          "type": "object"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "token",
            "ast",
            "symbol",
            "scope",
            "block",
            "ssa",
            "phi",
            "callsite",
            "trace",
            "bdd",
            "terminal",
            "class",
            "interface",
            "package",
            "component",
            "object",
            "action",
            "state",
            "actor",
            "port",
            "usecase",
            "pattern",
            "interaction",
            "lifeline",
            "deployment",
            "profile",
            "stereotype",
            "file",
            "artifact",
            "partition",
            "decision",
            "constraint",
            "instance",
            "annotation",
            "initial",
            "final",
            "function",
            "expression",
            "variable"
          ]
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          },
          "minItems": 0
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "basis",
        "evidence",
        "attributes",
        "label",
        "kind",
        "parent",
        "fields",
        "methods"
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "enum": [
            "source",
            "derived",
            "inferred",
            "observed"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "attributes": {
          "type": "object"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 0
        },
        "kind": {
          "enum": [
            "next_token",
            "contains",
            "declares",
            "extends",
            "implements",
            "type_use",
            "control_flow",
            "true",
            "false",
            "loop_back",
            "exception",
            "data_flow",
            "def_use",
            "control_dependence",
            "calls",
            "candidate_call",
            "recursion",
            "source_of",
            "projects_to",
            "low",
            "high",
            "generalization",
            "realization",
            "composition",
            "aggregation",
            "association",
            "dependency",
            "message",
            "transition",
            "include",
            "extend",
            "allocation",
            "deployment",
            "assembly",
            "delegation",
            "nesting",
            "return",
            "create",
            "destroy",
            "state_transition",
            "instantiates",
            "uses",
            "owns",
            "satisfies",
            "supplies",
            "links",
            "enters",
            "exits"
          ]
        }
      },
      "required": [
        "id",
        "basis",
        "evidence",
        "attributes",
        "source",
        "target",
        "label",
        "kind"
      ],
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "insufficient_evidence",
            "not_computed",
            "not_requested"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 0
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "minItems": 0
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          },
          "minItems": 0
        }
      },
      "required": [
        "status",
        "reason",
        "method",
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    }
  }
}
